{
  "name": "Woops - Inbound Channel Gateway Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "channel-inbound",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "channel-webhook-trigger",
      "name": "Webhook: Inbound Channel Trigger"
    },
    {
      "parameters": {
        "jsCode": "// Prepare InboundChannelMessageDto payload for Woops Agent Engine\nconst body = $json.body || $json;\n\nconst inboundMessage = {\n  channelType: body.channelType || 'WHATSAPP',\n  channelIdentifier: body.channelIdentifier || '+14155552671',\n  externalUserId: body.externalUserId || body.sender?.phone || 'customer_wa_101',\n  externalMessageId: body.messageId || 'msg_' + Date.now(),\n  externalConversationId: body.conversationId || 'conv_wa_101',\n  sender: {\n    name: body.sender?.name || 'Valued Customer',\n    phone: body.sender?.phone || '+14155552671'\n  },\n  message: {\n    type: 'text',\n    content: body.message?.content || body.text || 'Hello, I would like to check my subscription plan.'\n  }\n};\n\nreturn { json: inboundMessage };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [250, 0],
      "id": "format-inbound-payload",
      "name": "Format Inbound Payload"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/v1/channels/inbound",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Woops-Internal-Key",
              "value": "woops-super-secret-key-123456789"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 0],
      "id": "post-to-agent-engine",
      "name": "Forward to Woops Agent Engine"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [750, 0],
      "id": "respond-to-channel",
      "name": "Respond to Channel"
    }
  ],
  "connections": {
    "Webhook: Inbound Channel Trigger": {
      "main": [
        [
          {
            "node": "Format Inbound Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Inbound Payload": {
      "main": [
        [
          {
            "node": "Forward to Woops Agent Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to Woops Agent Engine": {
      "main": [
        [
          {
            "node": "Respond to Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
