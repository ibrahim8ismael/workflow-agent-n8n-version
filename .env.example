# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://woops:woops@localhost:5432/woops

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-secret-0123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=woops

# Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=woops
STORAGE_SECRET_KEY=woops123
STORAGE_BUCKET=woops-assets
STORAGE_PUBLIC_URL=http://localhost:9000/woops-assets

# Notification
# NOTIFICATION_PROVIDER selects OTP delivery: 'nodemailer' (email) or 'twilio' (SMS)
NOTIFICATION_PROVIDER=nodemailer
# EMAIL_PROVIDER selects the mail provider: 'nodemailer' | 'resend' | 'ses' | 'mailgun' | 'sendgrid'
EMAIL_PROVIDER=nodemailer
# Only needed when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# SMTP (nodemailer)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@woops.com
# Absolute HTTPS URL to the hosted public/logo/logo.svg asset in production.
EMAIL_LOGO_URL=/logo/logo.svg

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=Woops
LLM_LOW_PROVIDER=openai
LLM_LOW_MODEL=gpt-4o-mini
LLM_LOW_FALLBACKS=
LLM_MEDIUM_PROVIDER=openai
LLM_MEDIUM_MODEL=gpt-4o
LLM_MEDIUM_FALLBACKS=
LLM_HIGH_PROVIDER=openai
LLM_HIGH_MODEL=gpt-4o
LLM_HIGH_FALLBACKS=
LLM_MAX_RETRIES=2
BUSINESS_TIMEZONE=UTC

# Sentry
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=woops-backend

# Workflow Engine (n8n Integration)
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_TIMEOUT_MS=30000
N8N_MAX_RETRIES=2
N8N_WORKFLOW_MAP=

# Inter-Service Authentication (HMAC-SHA256 & Webhook Signing)
WOOPS_INTER_SERVICE_SECRET=change-me-to-a-secure-shared-secret-0123456789
WOOPS_SIGNATURE_EXPIRY_SECONDS=300

