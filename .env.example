# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://woops:woops@localhost:5432/woops

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=woops

# Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=woops
STORAGE_SECRET_KEY=woops123
STORAGE_BUCKET=woops-assets
STORAGE_PUBLIC_URL=http://localhost:9000/woops-assets

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=

# Sentry
SENTRY_DSN=
SENTRY_ENV=development

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=woops-backend
