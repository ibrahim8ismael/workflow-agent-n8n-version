{
  "name": "woops-agent-engine",
  "version": "1.0.0",
  "description": "WOOPS Platform Backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "lint:ci": "biome ci",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:browser": "playwright test",
    "test:browser:ui": "playwright test --ui",
    "test:browser:headed": "playwright test --headed",
    "test:browser:auth": "playwright codegen --save-storage=tests/browser/.auth/user.json http://localhost:3000/signin",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "runtime:checkpoint:setup": "tsx scripts/setup-langgraph-checkpoints.ts",
    "postinstall": "command -v lefthook >/dev/null 2>&1 && lefthook install || true",
    "eval": "vitest run src/modules/runtime/eval"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.24",
    "@ai-sdk/google": "4.0.28",
    "@ai-sdk/groq": "4.0.16",
    "@ai-sdk/openai": "4.0.24",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/lib-storage": "^3.0.0",
    "@langchain/langgraph": "1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "1.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "^7.0.0",
    "@sentry/node": "^9.0.0",
    "ai": "7.0.42",
    "argon2": "^0.41.0",
    "axios": "^1.7.0",
    "bullmq": "^5.0.0",
    "compression": "^1.7.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.0",
    "date-fns": "^4.0.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "jsonwebtoken": "^9.0.0",
    "nestjs-pino": "^4.0.0",
    "nodemailer": "9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.0",
    "pg": "8.22.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.0",
    "swagger-ui-express": "^5.0.0",
    "tsx": "4.23.1",
    "twilio": "6.0.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@playwright/test": "1.63.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.0",
    "@types/compression": "^1.7.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^4.28.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "^4.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "lefthook": "2.1.10",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "unplugin-swc": "1.5.9",
    "vitest": "^3.0.0"
  }
}
