generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum UserRole {
  USER
  SYSTEM_ADMINISTRATOR
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AgentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  ERROR
}

enum ConversationStatus {
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum MemoryType {
  CONVERSATION
  USER
  AGENT
}

enum ChannelType {
  WIDGET
  WHATSAPP
  MESSENGER
  INSTAGRAM
  TELEGRAM
  EMAIL
  SLACK
  DISCORD
  API
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SubscriptionTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum IntegrationCategory {
  AI
  COMMUNICATION
  CRM
  PAYMENT
  ANALYTICS
  STORAGE
  OTHER
}

enum WalletTransactionType {
  SUBSCRIPTION_CREDIT
  TOP_UP_PURCHASE
  BONUS_GRANT
  CONSUMPTION
  REFUND
  EXPIRATION
  ADJUSTMENT
}

enum BillingEventType {
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_UPGRADED
  SUBSCRIPTION_DOWNGRADED
  SUBSCRIPTION_CANCELED
  SUBSCRIPTION_EXPIRED
  TOP_UP_PURCHASED
  CREDIT_CONSUMED
  OPERATION_CONSUMED
  REFUND_ISSUED
  CHARGE_FAILED
  GRACE_PERIOD_STARTED
  HARD_LIMIT_REACHED
}

enum RuntimeIdempotencyStatus {
  STARTED
  COMPLETED
  FAILED
  UNKNOWN
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_CREDITS
  FREE_OPERATIONS
}

// ──────────────────────────────────────────────
// Layer 1 — Identity
// ──────────────────────────────────────────────

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?
  name            String?
  avatarUrl       String?
  emailVerifiedAt DateTime?
  role            UserRole   @default(USER)
  isActive        Boolean    @default(true)
  tokenVersion    Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  sessions             Session[]
  apiKeys              ApiKey[]
  organizationMembers  OrganizationMember[]
  sentInvitations      OrganizationMember[]  @relation("SentInvitations")
  agents               Agent[]              @relation("UserAgents")
  skills               Skill[]              @relation("UserSkills")
  conversations        Conversation[]       @relation("UserConversations")
  knowledgeDocuments   KnowledgeDocument[]  @relation("UserKnowledgeDocuments")
  memories             Memory[]             @relation("UserMemories")
  integrations         Integration[]        @relation("UserIntegrations")
  n8nConnections       N8nConnection[]      @relation("UserN8nConnections")
  automations          Automation[]         @relation("UserAutomations")
  notifications        Notification[]
  subscription         Subscription?        @relation("UserSubscription")
  wallet               Wallet?
  couponRedemptions    CouponRedemption[]
  adminImpersonations  ImpersonationLog[]  @relation("AdminImpersonations")
  targetImpersonations ImpersonationLog[]  @relation("TargetImpersonations")
  auditLogs            AuditLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  members            OrganizationMember[]
  apiKeys            ApiKey[]
  agents             Agent[]              @relation("OrganizationAgents")
  skills             Skill[]              @relation("OrganizationSkills")
  conversations      Conversation[]       @relation("OrganizationConversations")
  knowledgeDocuments KnowledgeDocument[]  @relation("OrganizationKnowledgeDocuments")
  memories           Memory[]             @relation("OrganizationMemories")
  integrations       Integration[]        @relation("OrganizationIntegrations")
  n8nConnections     N8nConnection[]      @relation("OrganizationN8nConnections")
  automations        Automation[]         @relation("OrganizationAutomations")
  notifications      Notification[]
  subscription       Subscription?        @relation("OrganizationSubscription")
  wallet             Wallet?

  @@map("organizations")
}

// ──────────────────────────────────────────────
// Layer 2 — Identity Relations
// ──────────────────────────────────────────────

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  invitedById    String?
  joinedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  invitedBy    User?        @relation("SentInvitations", fields: [invitedById], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

// ──────────────────────────────────────────────
// Layer 3 — Authentication
// ──────────────────────────────────────────────

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  device           String?
  browser          String?
  ip               String?
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  deletedAt        DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([refreshTokenHash])
  @@index([userId])
  @@index([userId, expiresAt])
}

model ApiKey {
  id             String       @id @default(uuid())
  name           String
  key            String       @unique
  keyPrefix      String
  status         ApiKeyStatus @default(ACTIVE)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  userId         String?
  organizationId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("api_keys")
}

// ──────────────────────────────────────────────
// Layer 4 — Core Business
// ──────────────────────────────────────────────

model Agent {
  id             String      @id @default(uuid())
  name           String
  description    String?
  instructions   String?
  personality    String?
  model          String
  status         AgentStatus @default(DRAFT)
  userId         String?
  organizationId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  user               User?                @relation("UserAgents", fields: [userId], references: [id])
  organization       Organization?        @relation("OrganizationAgents", fields: [organizationId], references: [id])
  skills             AgentSkill[]
  conversations      Conversation[]
  channels           Channel[]
  memories           Memory[]
  runs               Run[]
  runtimeDeployments RuntimeDeployment[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("agents")
}

enum SkillExecutionMode {
  AI_ONLY
  N8N_WORKFLOW
  KNOWLEDGE_RETRIEVAL
  MEMORY_RETRIEVAL
  HYBRID
  HUMAN_APPROVAL
}

model Skill {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  description     String?
  category        String?
  version         Int                  @default(1)
  executionMode   SkillExecutionMode   @default(AI_ONLY)
  status          String               @default("DRAFT")
  visibility      String               @default("PRIVATE")
  inputSchema     Json?
  outputSchema    Json?
  instructions    String?
  timeout         Int?
  retryPolicy     Json?
  successCriteria Json?
  metadata        Json?
  userId          String?
  organizationId  String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  user         User?               @relation("UserSkills", fields: [userId], references: [id])
  organization Organization?       @relation("OrganizationSkills", fields: [organizationId], references: [id])
  agentSkills  AgentSkill[]

  @@index([slug])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@map("skills")
}

model AgentSkill {
  id        String   @id @default(uuid())
  agentId   String
  skillId   String
  name      String
  enabled   Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  agent Agent @relation(fields: [agentId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([agentId, skillId])
  @@index([agentId])
  @@index([skillId])
  @@map("agent_skills")
}

model Conversation {
  id             String             @id @default(uuid())
  title          String?
  status         ConversationStatus @default(ACTIVE)
  metadata       Json?
  agentId        String
  userId         String?
  organizationId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  agent        Agent     @relation(fields: [agentId], references: [id])
  user         User?     @relation("UserConversations", fields: [userId], references: [id])
  organization Organization? @relation("OrganizationConversations", fields: [organizationId], references: [id])
  messages     Message[]
  runs         Run[]

  @@index([agentId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([agentId, status])
  @@map("conversations")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ──────────────────────────────────────────────
// Layer 5 — Knowledge & Memory
// ──────────────────────────────────────────────

model KnowledgeDocument {
  id             String   @id @default(uuid())
  title          String
  source         String?
  contentType    String
  content        String?
  metadata       Json?
  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user         User?                    @relation("UserKnowledgeDocuments", fields: [userId], references: [id])
  organization Organization?            @relation("OrganizationKnowledgeDocuments", fields: [organizationId], references: [id])
  chunks       KnowledgeDocumentChunk[]

  @@index([userId])
  @@index([organizationId])
  @@map("knowledge_documents")
}

model KnowledgeDocumentChunk {
  id                  String   @id @default(uuid())
  knowledgeDocumentId String
  content             String
  embedding           Unsupported("vector(1536)")?
  metadata            Json?
  chunkIndex          Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  knowledgeDocument KnowledgeDocument @relation(fields: [knowledgeDocumentId], references: [id])

  @@index([knowledgeDocumentId])
  @@index([knowledgeDocumentId, chunkIndex])
  @@map("knowledge_document_chunks")
}

model Memory {
  id             String     @id @default(uuid())
  agentId        String
  type           MemoryType
  key            String
  content        String
  metadata       Json?
  userId         String?
  organizationId String?
  expiresAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  agent        Agent         @relation(fields: [agentId], references: [id])
  user         User?         @relation("UserMemories", fields: [userId], references: [id])
  organization Organization? @relation("OrganizationMemories", fields: [organizationId], references: [id])

  @@unique([agentId, key, type])
  @@index([agentId])
  @@index([userId])
  @@index([organizationId])
  @@index([type])
  @@map("memories")
}

// ──────────────────────────────────────────────
// Layer 6 — Integrations & Channels
// ──────────────────────────────────────────────

model Integration {
  id             String              @id @default(uuid())
  name           String
  category       IntegrationCategory
  provider       String
  status         String              @default("DISCONNECTED")
  config         Json?
  userId         String?
  organizationId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  user         User?                  @relation("UserIntegrations", fields: [userId], references: [id])
  organization Organization?          @relation("OrganizationIntegrations", fields: [organizationId], references: [id])
  credentials  IntegrationCredential[]

  @@index([userId])
  @@index([organizationId])
  @@index([provider])
  @@index([category])
  @@map("integrations")
}

model IntegrationCredential {
  id            String   @id @default(uuid())
  integrationId String
  encryptedData String
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId])
  @@map("integration_credentials")
}

// ──────────────────────────────────────────────
// Client-managed n8n connections & automations
// (@PLAN.N8N.CLIENT.MODE.md)
// ──────────────────────────────────────────────

model N8nConnection {
  id             String    @id @default(uuid())
  name           String
  baseUrl        String
  status         String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | ACTIVE | INVALID | SUSPENDED
  lastVerifiedAt DateTime?
  lastError      String?
  metadata       Json?
  userId         String?
  organizationId String? // exactly one populated (owner XOR)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User?                     @relation("UserN8nConnections", fields: [userId], references: [id])
  organization Organization?             @relation("OrganizationN8nConnections", fields: [organizationId], references: [id])
  credential   N8nConnectionCredential?
  automations  Automation[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("n8n_connections")
}

model N8nConnectionCredential {
  id            String   @id @default(uuid())
  connectionId  String   @unique
  encryptedData String // AES-256-GCM via SecretBoxService
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  connection N8nConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("n8n_connection_credentials")
}

model Automation {
  id                 String    @id @default(uuid())
  name               String
  description        String?
  blueprint          Json // approved AutomationBlueprint (immutable after approval)
  status             String    @default("DESIGN") // DESIGN | PENDING_APPROVAL | PROVISIONING | ACTIVE | FAILED | SUSPENDED
  connectionId       String
  externalWorkflowId String?
  webhookPath        String?
  lastSyncedAt       DateTime?
  userId             String?
  organizationId     String? // exactly one populated (owner XOR)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  connection N8nConnection @relation(fields: [connectionId], references: [id])
  user       User?         @relation("UserAutomations", fields: [userId], references: [id])
  organization Organization? @relation("OrganizationAutomations", fields: [organizationId], references: [id])

  @@index([connectionId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@map("automations")
}

model Channel {
  id        String      @id @default(uuid())
  agentId   String
  type      ChannelType
  name      String?
  status    String      @default("ACTIVE")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  agent   Agent           @relation(fields: [agentId], references: [id])
  configs ChannelConfig[]

  @@unique([agentId, type])
  @@index([agentId])
  @@map("channels")
}

model ChannelConfig {
  id        String   @id @default(uuid())
  channelId String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, key])
  @@index([channelId])
  @@map("channel_configs")
}

// ──────────────────────────────────────────────
// Layer 7 — Runs & Runtime
// ──────────────────────────────────────────────

enum RunStatus {
  CREATED
  PREPARING
  PLANNING
  EXECUTING
  WAITING
  GENERATING
  PERSISTING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

model Run {
  id              String    @id @default(uuid())
  agentId         String
  conversationId  String?
  userId          String?
  organizationId  String?
  status          RunStatus @default(CREATED)

  agent        Agent         @relation(fields: [agentId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  plan            Json?
  result          String?
  error           String?
  metadata        Json?
  startedAt       DateTime?
  completedAt     DateTime?
  promptTokens    Int       @default(0)
  completionTokens Int      @default(0)
  totalTokens     Int       @default(0)
  estimatedCost   Decimal   @default(0)
  durationMs      Int?
  version         Int       @default(1)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  idempotencyKeys RuntimeIdempotencyKey[]

  @@index([agentId])
  @@index([conversationId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([agentId, status])
  @@map("runs")
}

model RuntimeIdempotencyKey {
  id            String                   @id @default(uuid())
  key           String                   @unique
  runId         String
  toolId        String
  logicalAction String
  inputHash     String
  status        RuntimeIdempotencyStatus @default(STARTED)
  result        Json?
  error         String?
  startedAt     DateTime                 @default(now())
  completedAt   DateTime?
  updatedAt     DateTime                 @updatedAt
  expiresAt     DateTime?

  run Run @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([status])
  @@index([expiresAt])
  @@map("runtime_idempotency_keys")
}

model RuntimeDeployment {
  id                  String   @id @default(uuid())
  agentId             String
  version             Int
  status              String   @default("PENDING")
  runtimeUrl          String?
  runtimeDeploymentId String?
  metadata            Json?
  deployedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId, version])
  @@index([agentId])
  @@index([status])
  @@map("runtime_deployments")
}

// ──────────────────────────────────────────────
// Layer 8 — Billing
// ──────────────────────────────────────────────

model SubscriptionPlan {
  id          String           @id @default(uuid())
  tier        SubscriptionTier @unique
  name        String
  description String?
  price       Decimal
  currency    String           @default("USD")
  interval    String
  features    Json?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  subscriptions Subscription[]
  quota         PlanQuota?

  @@map("subscription_plans")
}

model PlanQuota {
  id                    String @id @default(uuid())
  planId                String @unique
  aiCreditsPerMonth     BigInt
  operationsPerMonth    BigInt
  maxAgents             Int
  maxTeamMembers        Int
  maxKnowledgeBases     Int
  storageBytes          BigInt
  maxChannels           Int
  maxIntegrations       Int?
  maxApiKeys            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("plan_quotas")
}

model Subscription {
  id                    String             @id @default(uuid())
  planId                String
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  provider              String
  providerSubscriptionId String            @unique
  trialEndsAt           DateTime?
  canceledAt            DateTime?
  userId                String?
  organizationId        String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?

  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  user         User?            @relation("UserSubscription", fields: [userId], references: [id])
  organization Organization?    @relation("OrganizationSubscription", fields: [organizationId], references: [id])
  invoices     Invoice[]
  usageMeters  UsageMeter[]
  @@unique([userId])
  @@unique([organizationId])

  @@index([planId])
  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([provider, providerSubscriptionId])
  @@map("subscriptions")
}

model Invoice {
  id                String    @id @default(uuid())
  subscriptionId    String
  amount            Decimal
  currency          String    @default("USD")
  status            String    @default("PENDING")
  providerInvoiceId String?
  paidAt            DateTime?
  dueDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([status])
  @@index([subscriptionId, status])
  @@map("invoices")
}

// ──────────────────────────────────────────────
// Layer 9 — Billing Wallet & Credits
// ──────────────────────────────────────────────

model Wallet {
  id              String   @id @default(uuid())
  balanceCredits  BigInt   @default(0)
  balanceCreditsUsd Decimal @default(0)
  lifetimeCredits BigInt   @default(0)
  lifetimeSpendUsd Decimal  @default(0)
  currency        String   @default("USD")
  softLimit       BigInt?
  hardLimit       BigInt?
  gracePeriodEnd  DateTime?
  isFrozen        Boolean  @default(false)
  version         Int      @default(0)
  userId          String?
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  user         User?                @relation(fields: [userId], references: [id])
  organization Organization?        @relation(fields: [organizationId], references: [id])
  transactions WalletTransaction[]
  purchases    TopUpPurchase[]

  @@unique([userId])
  @@unique([organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("wallets")
}

model WalletTransaction {
  id              String                @id @default(uuid())
  walletId        String
  type            WalletTransactionType
  amountCredits   BigInt
  amountUsd       Decimal?
  currency        String                @default("USD")
  balanceBefore   BigInt
  balanceAfter    BigInt
  description     String?
  referenceType   String?
  referenceId     String?
  metadata        Json?
  couponId        String?
  expiresAt       DateTime?
  createdAt       DateTime              @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([walletId])
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([type])
  @@index([couponId])
  @@map("wallet_transactions")
}

// ──────────────────────────────────────────────
// Layer 10 — Usage & Metering
// ──────────────────────────────────────────────

model UsageMeter {
  id             String   @id @default(uuid())
  subscriptionId String
  aiCreditsUsed  BigInt   @default(0)
  aiCreditsLimit BigInt   @default(0)
  operationsUsed BigInt   @default(0)
  operationsLimit BigInt  @default(0)
  resetAt        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, resetAt])
  @@index([subscriptionId])
  @@index([resetAt])
  @@map("usage_meters")
}

// ──────────────────────────────────────────────
// Layer 11 — Top-Up Packages & Coupons
// ──────────────────────────────────────────────

model TopUpPackage {
  id            String   @id @default(uuid())
  name          String
  description   String?
  priceUsd      Decimal
  creditsAmount BigInt
  operationsAmount BigInt?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  purchases TopUpPurchase[]

  @@index([isActive])
  @@map("top_up_packages")
}

model TopUpPurchase {
  id              String   @id @default(uuid())
  packageId       String
  walletId        String
  amountPaidUsd   Decimal
  currency        String   @default("USD")
  creditsGranted  BigInt
  operationsGranted BigInt?
  status          String   @default("COMPLETED")
  provider        String   @default("manual")
  providerPaymentId String?
  invoiceId       String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  package TopUpPackage @relation(fields: [packageId], references: [id])
  wallet  Wallet       @relation(fields: [walletId], references: [id])

  @@index([packageId])
  @@index([walletId])
  @@index([status])
  @@index([providerPaymentId])
  @@map("top_up_purchases")
}

model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  type            CouponType
  value           Decimal
  maxRedemptions  Int?
  currentRedemptions Int    @default(0)
  minAmountUsd    Decimal?
  maxAmountUsd    Decimal?
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean    @default(true)
  metadata        Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  redemptions CouponRedemption[]
  transactions WalletTransaction[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid())
  couponId   String
  userId     String
  walletId   String?
  walletTransactionId String?
  amountUsd  Decimal?
  metadata   Json?
  createdAt  DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([couponId])
  @@index([userId])
  @@index([createdAt])
  @@map("coupon_redemptions")
}

// ──────────────────────────────────────────────
// Layer 12 — Billing Events
// ──────────────────────────────────────────────

model BillingEvent {
  id          String          @id @default(uuid())
  type        BillingEventType
  entityType  String
  entityId    String
  userId      String?
  organizationId String?
  metadata    Json?
  createdAt   DateTime        @default(now())

  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@index([organizationId])
  @@index([createdAt, type])
  @@map("billing_events")
}

// ──────────────────────────────────────────────
// Layer 13 — Admin & System
// ──────────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  overrides FeatureFlagOverride[]

  @@index([key])
  @@index([enabled])
  @@map("feature_flags")
}

model FeatureFlagOverride {
  id          String   @id @default(uuid())
  flagId      String
  entityType  String
  entityId    String
  enabled     Boolean
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flag FeatureFlag @relation(fields: [flagId], references: [id])

  @@unique([flagId, entityType, entityId])
  @@index([flagId])
  @@index([entityType, entityId])
  @@map("feature_flag_overrides")
}

model ImpersonationLog {
  id              String   @id @default(uuid())
  adminId         String
  targetUserId    String
  targetOrganizationId String?
  reason          String?
  sessionToken    String?
  impersonatedAt  DateTime @default(now())
  endedAt         DateTime?
  metadata        Json?

  admin      User         @relation("AdminImpersonations", fields: [adminId], references: [id])
  targetUser User         @relation("TargetImpersonations", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
  @@index([impersonatedAt])
  @@map("impersonation_logs")
}

// ──────────────────────────────────────────────
// Layer 14 — System
// ──────────────────────────────────────────────

model Notification {
  id             String   @id @default(uuid())
  type           String
  title          String
  message        String?
  data           Json?
  readAt         DateTime?
  userId         String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([readAt])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  user User? @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
